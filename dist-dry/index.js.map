    "help": {
      "tour_type_package_label": "Multi-day Package",
      "tour_type_package_desc": "Overnight trip spanning multiple days. Requires Stops (for auto-todos) and full pricing with room types.",
      "tour_type_day_label": "Day Tour",
      "tour_type_day_desc": "Starts and ends same day. No room pricing — only adult and child price per person.",
      "metadata": "Core system fields. Title and Duration appear in lists and search. Status controls customer visibility. Set Language correctly so translations work. These are internal — customers see the richer Content Data section below.",
      "content_data": "Everything the customer sees on the tour page. Tour Name is the big headline, Base Price shows as the \"from\" price in tour cards, Highlights appear as bullet icons, Includes/Excludes as a checklist, Hero Summary is the 2–3 sell lines at the top, and Story is the long editorial body text.",
      "hero_image": "The full-width banner at the top of the tour page. Use the Add hero image button to pick from your tenant gallery or upload a new file. The hero is always set explicitly — it does not auto-pull from the gallery list.",
      "gallery_images": "A collection of photos shown in the tour's image gallery section. Add images with the Add gallery image button — each one appends to the list without touching the hero or other fields. You can also link an entire Photo Library below for a shared pool of reusable images.",
      "destination": "The featured destination card on the tour page — name plus a photo. Tick Destinations under Universal Site Placement to also show this tour on your website's Destinations listing page.",
      "accommodation": "The hotel or lodging featured on the tour page — title, image, and a short description. Tick Accommodation under Universal Site Placement to include it in your website's accommodation showcase.",
      "site_placement": "Controls where this tour appears on your website beyond its own page. Featured Tours shows it in the homepage featured row. Destinations adds it to the destinations catalog page. Accommodation shows it in the accommodation showcase. Hero Spotlight rotates this tour into the homepage hero banner.",
      "itinerary_copy": "Day-by-day narrative shown on the public tour page. Write it to sell the experience to the customer. This is separate from the Stops tab — Stops drive the operations workflow and auto-generate staff todos.",
      "linked_destinations_label": "Linked Destinations",
      "linked_destinations": "Connect this tour to entries in your Destinations catalog. Linked destinations appear as a related-destinations block on the tour page and enable cross-linking between tours. Manage the catalog via the Manage catalog link.",
      "linked_hotels_label": "Linked Hotels",
      "linked_hotels": "Attach hotels from your Hotels catalog with the number of nights stayed. These power the accommodation section of the tour page and are also used by the ops workflow. Manage the hotel catalog via the Manage catalog link.",
      "linked_libraries_label": "Linked Photo Libraries",
      "linked_libraries": "Shared collections of reusable photos — e.g. \"Ha Long Bay photos\". Linking a library makes those photos available in the tour's gallery and hero picker without duplicating uploads. Set the hint to gallery, hero, or itinerary to suggest where those photos are most relevant.",
      "stops_builder_title": "Stops power the Operations workflow.",
      "stops_builder": "Every stop you add here automatically generates a checklist of todos for your team — guides, drivers, hotels, meals — in the Ops Board. The more complete your stops (nights, meals, transport), the richer and more accurate the auto-generated task list.",
      "stops_builder_note": "Add stops in order: Arrival, each destination in sequence, then Departure. Set nights to 0 for transit or same-day stops.",
      "stop_nights": "Number of nights the group sleeps at this destination. Controls how many days this stop spans on the itinerary. Set to 0 for transit or departure stops — same day, no overnight, no hotel todo generated.",
      "stop_meals": "Toggle which meals are included at this stop (B = Breakfast, L = Lunch, D = Dinner). Generates meal-coordination todos for the ops team and appears in the customer-facing itinerary.",
      "price_settings": "The display currency is how prices are shown to customers on your website. It is separate from your booking currency. All price rows below are stored in your booking currency — the display currency is applied as a conversion on the public pages.",
      "seasons": "Date ranges that determine which price row applies. Example: High Season Dec–Feb, Low Season Mar–Nov. The system automatically matches the customer's travel date to the correct season when calculating the price.",
      "pax_bands": "Group size brackets that set per-person prices. Larger groups often get a lower rate. Example: Solo (1–2 pax), Small Group (3–8), Group 9+. The booking engine picks the band by counting all adults and children in the booking.",
      "segments": "Tour variants at different service levels — e.g. Standard vs Premium. Each segment has its own price grid but shares the same itinerary. The customer sees and selects a segment when booking. If you only offer one level, keep the default segment as-is.",
      "tour_prices": "The price grid — one row per Season + Segment + Pax Band combination. Each row has per-person prices by traveller type: Shared room (adult in double), Triple room, Private room, Child (sharing parents' room), and Infant (usually free or discounted). For Day Tours only adult and child prices apply.",
      "pricing_definitions": "Notes shown below the price total in the booking widget as a Good to Know block. Use this to list what's included (e.g. \"Breakfast daily, all entrance fees\"), age brackets for child pricing, and cancellation or deposit policies."
    },
