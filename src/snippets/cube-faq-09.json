hrink-0\">\n                                        <input type=\"checkbox\" id=\"toggle\" class=\"sr-only\" data-ve-input=\"1\" />\n                                        <label class=\"bg-slate-900\" for=\"toggle\" data-ve-text=\"1\">\n                                            <span aria-hidden=\"true\" data-ve-text=\"1\"></span>\n                                            <span class=\"sr-only\" data-ve-text=\"1\">Pay annually</span>\n                                        </label>\n                                    </div>\n                                    <div class=\"text-sm text-slate-500 font-medium min-w-[6rem]\">Yearly <span class=\"text-emerald-500\" data-ve-text=\"1\">(-20%)</span></div>\n                                </div>\n\n                            </div>\n\n                            \n                            <div class=\"flex flex-col justify-center p-4 md:px-6 bg-slate-800 md:border-l border-slate-700 order-1 md:order-none md:text-center mt-6 md:mt-0\">\n                                <div class=\"font-hkgrotesk text-lg font-bold text-indigo-500 mb-0.5\">Starter</div>\n                                <div>\n                                    <span class=\"text-xl font-semibold\" data-ve-text=\"1\">$</span><span class=\"text-2xl font-semibold\" data-ve-text=\"1\">29</span><span class=\"text-sm text-slate-500 font-medium\" data-ve-text=\"1\">/mo</span>\n                                </div>\n                            </div>\n\n                            \n                            <div class=\"flex flex-col justify-center p-4 md:px-6 bg-slate-800 md:border-l border-slate-700 order-2 md:order-none md:text-center mt-6 md:mt-0\">\n                                <div class=\"font-hkgrotesk text-lg font-bold text-indigo-500 mb-0.5\">Agency</div>\n                                <div>\n                                    <span class=\"text-xl font-semibold\" data-ve-text=\"1\">$</span><span class=\"text-2xl font-semibold\" data-ve-text=\"1\">49</span><span class=\"text-sm text-slate-500 font-medium\" data-ve-text=\"1\">/mo</span>\n                                </div>\n                            </div>\n\n                            \n                            <div class=\"flex flex-col justify-center p-4 md:px-6 bg-slate-800 md:border-l border-slate-700 order-3 md:order-none md:text-center mt-6 md:mt-0\">\n                                <div class=\"font-hkgrotesk text-lg font-bold text-indigo-500 mb-0.5\">Team</div>\n                                <div>\n                                    <span class=\"text-xl font-semibold\" data-ve-text=\"1\">$</span><span class=\"text-2xl font-semibold\" data-ve-text=\"1\">79</span><span class=\"text-sm text-slate-500 font-medium\" data-ve-text=\"1\">/mo</span>\n                                </div>\n                            </div>\n\n                            \n                            <div class=\"hidden md:flex flex-col justify-center px-4 md:px-6 py-2 bg-slate-700/25 md:col-span-3\">\n                                <span class=\"text-xs uppercase font-semibold text-slate-500\" data-ve-text=\"1\">Usage</span>\n                            </div>\n                            <div class=\"flex flex-col justify-center px-4 md:px-6 py-2 bg-slate-700/25 md:border-l border-slate-700 order-1 md:order-none\">\n                                <span class=\"md:hidden text-xs uppercase font-semibold text-slate-500\" data-ve-text=\"1\">Usage</span>\n                            </div>\n                            <div class=\"flex flex-col justify-center px-4 md:px-6 py-2 bg-slate-700/25 md:border-l border-slate-700 order-2 md:order-none\">\n                                <span class=\"md:hidden text-xs uppercase font-semibold text-slate-500\" data-ve-text=\"1\">Usage</span>\n                            </div>\n                            <div class=\"flex flex-col justify-center px-4 md:px-6 py-2 bg-slate-700/25 md:border-l border-slate-700 o