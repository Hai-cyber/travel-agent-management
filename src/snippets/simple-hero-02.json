_at_4.5px_4.5px,var(--color-gray-600)_4.5px,transparent_0)] before:bg-[length:16px_9px] after:w-[41px] mb-8\">\n                                    <span class=\"text-white font-medium text-[13px]\" data-ve-text=\"1\">cruip.com</span>\n                                </div>\n                                <div class=\"text-gray-500 text-sm font-mono [&_span]:opacity-0\">\n                                    <span class=\"text-gray-200 animate-[code-1_10s_infinite]\" data-ve-text=\"1\">npm login</span> <span class=\"animate-[code-2_10s_infinite]\" data-ve-text=\"1\">--registry=https://npm.pkg.github.com</span><br />\n                                    <span class=\"animate-[code-3_10s_infinite]\" data-ve-text=\"1\">--scope=@phanatic</span> <span class=\"animate-[code-4_10s_infinite]\" data-ve-text=\"1\">Successfully logged-in.</span><br /><br />\n                                    <span class=\"text-gray-200 animate-[code-5_10s_infinite]\" data-ve-text=\"1\">npm publish</span><br />\n                                    <span class=\"animate-[code-6_10s_infinite]\" data-ve-text=\"1\">Package published.</span>\n                                </div>\n                            </div>\n                        </div>\n                        \n                    </div>\n\n                </div>\n            </section>"
