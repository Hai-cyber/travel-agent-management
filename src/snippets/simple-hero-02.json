  "html": "<section class=\"relative\" style=\"padding-top: 96px\" data-ve-hero-padded=\"1\">\n\n                \n                <div class=\"absolute left-1/2 transform -translate-x-1/2 top-0 pointer-events-none -z-10\" aria-hidden=\"true\">\n                    <img class=\"max-w-none\" src=\"/api/tenant/template-assets/simple-html/images/stripes.svg\" width=\"768\" height=\"432\" alt=\"Stripes\" data-ve-img=\"1\" />\n                </div>\n\n                \n                <div class=\"absolute left-1/2 -translate-x-1/2 -top-32 ml-[580px] pointer-events-none\" aria-hidden=\"true\">\n                    <div class=\"w-80 h-80 rounded-full bg-linear-to-tr from-blue-500 opacity-50 blur-[160px] will-change-[filter]\"></div>\n                </div>\n                <div class=\"absolute left-1/2 -translate-x-1/2 top-[420px] ml-[380px] pointer-events-none\" aria-hidden=\"true\">\n                    <div class=\"w-80 h-80 rounded-full bg-linear-to-tr from-blue-500 to-gray-900 opacity-50 blur-[160px] will-change-[filter]\"></div>\n                </div>\n                <div class=\"absolute left-1/2 -translate-x-1/2 top-[640px] -ml-[300px] pointer-events-none\" aria-hidden=\"true\">\n                    <div class=\"w-80 h-80 rounded-full bg-linear-to-tr from-blue-500 to-gray-900 opacity-50 blur-[160px] will-change-[filter]\"></div>\n                </div>                \n\n                <div class=\"max-w-6xl mx-auto px-4 sm:px-6\">\n\n                    \n                    <div class=\"pt-32 pb-12 md:pt-40 md:pb-20\">\n\n                        \n                        <div class=\"text-center pb-12 md:pb-16\">\n                            <div class=\"mb-6 border-y [border-image:linear-gradient(to_right,transparent,--theme(--color-slate-300/.8),transparent)1]\">\n                                <div class=\"flex justify-center -space-x-3 -mx-0.5\">\n                                    <img class=\"rounded-full border-2 border-gray-50 box-content\" src=\"