png\" width=\"60\" height=\"60\" alt=\"Logo\" data-ve-img=\"1\">\n                                </a>\n                            </div>\n                            <h2 class=\"font-inter-tight text-3xl md:text-4xl font-bold text-zinc-900 mb-4\" data-ve-text=\"1\">Start your journey \n                                <em class=\"relative not-italic inline-flex justify-center items-end\" data-ve-text=\"1\">\n                                    today\n                                    <svg class=\"absolute fill-zinc-300 w-[calc(100%+1rem)] -z-10\" xmlns=\"http://www.w3.org/2000/svg\" width=\"120\" height=\"10\" viewBox=\"0 0 120 10\" aria-hidden=\"true\" preserveAspectRatio=\"none\">\n                                        <path d=\"M118.273 6.09C79.243 4.558 40.297 5.459 1.305 9.034c-1.507.13-1.742-1.521-.199-1.81C39.81-.228 79.647-1.568 118.443 4.2c1.63.233 1.377 1.943-.17 1.89Z\" />\n                                    </svg>\n                                </em>\n                            </h2>\n                            <p class=\"text-lg text-zinc-500 mb-8\" data-ve-text=\"1\">Gray removes creative distances by connecting beginners, pros, and every team in between. Are you ready to start your journey?</p>\n                            <div class=\"max-w-xs mx-auto sm:max-w-none sm:inline-flex sm:justify-center space-y-4 sm:space-y-0 sm:space-x-4\">\n                                <div>\n                                    <a class=\"btn text-zinc-100 bg-zinc-900 hover:bg-zinc-800 w-full shadow-sm\" href=\"request-demo.html\" data-ve-text=\"1\" data-ve-btn=\"1\">Request Demo</a>\n                                </div>\n                                <div>\n                                    <a class=\"btn text-zinc-600 bg-white hover:text-zinc-900 w-full shadow-sm\" href=\"#\" data-ve-text=\"1\" data-ve-btn=\"1\">Try for Free</a>\n                                </div>\n                            </div>\n                        </div>\n  </div>\n</se