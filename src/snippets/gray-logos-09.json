  "html": "<section class=\"py-12 md:py-20\">\n  <div class=\"max-w-6xl mx-auto px-4 sm:px-6\">\n<div class=\"rounded-sm h-full w-[22rem] border border-transparent [background:linear-gradient(#323237,#323237)_padding-box,linear-gradient(120deg,var(--color-zinc-700),--theme(--color-zinc-700/0),var(--color-zinc-700))_border-box] p-5\">\n                                    <div class=\"flex items-center mb-4\">\n                                        <img class=\"shrink-0 rounded-full mr-3\" src=\"/api/tenant/template-assets/gray-html/images/testimonial-07.jpg\" width=\"44\" height=\"44\" alt=\"Testimonial 07\" data-ve-img=\"1\" />\n                                        <div>\n                                            <div class=\"font-inter-tight font-bold text-zinc-200\">Carlotta Grech</div>\n                                            <div>\n                                                <a class=\"text-sm font-medium text-zinc-500 hover:text-zinc-300 transition\" href=\"#\" data-ve-text=\"1\" data-ve-btn=\"1\">@carlagrech</a>\n                                            </div>\n                                        </div>\n                                    </div>\n                                    <div class=\"text-zinc-500 before:content-['\\0022'] after:content-['\\0022']\">\n                                        Extremely thoughtful approaches to business. I highly recommend this product to anyone wanting to jump into something new.\n                                    </div>\n                                </div>\n                                \n                                <div class=\"rounded-sm h-full w-[22rem] border border-transparent [background:linear-gradient(#323237,#323237)_padding-box,linear-gradient(120deg,var(--color-zinc-700),--theme(--color-zinc-700/0),var(--color-zinc-700))_border-box] p-5\">\n                                    <div class=\"flex items-center mb-4\">\n                                        <img class=\"shrin