>\n                                    </div>\n                                    <div class=\"font-red-hat-display inline-flex items-baseline mb-2\">\n                                        <span class=\"h4 text-gray-600 dark:text-gray-400\" data-ve-text=\"1\">$</span>\n                                        <span class=\"h3\" data-ve-text=\"1\">27</span>\n                                        <span class=\"font-medium text-gray-500 dark:text-gray-400\" data-ve-text=\"1\">/billed yearly</span>\n                                    </div>\n                                    <div class=\"text-gray-500 dark:text-gray-400\">— Lorem ipsum dolor amet sit consect adipiscing.</div>\n                                </div>\n                                <div class=\"mt-24\">\n                                    <a class=\"btn-sm text-white bg-teal-500 hover:bg-teal-400 w-full\" href=\"#\" data-ve-text=\"1\" data-ve-btn=\"1\">Go Premium</a>\n                                </div>\n                            </div>\n\n                            \n                            <div class=\"flex flex-col h-full p-6 bg-white dark:bg-gray-800 shadow-sm\">\n                                <div class=\"grow mb-4 pb-4\">\n                                    <div class=\"flex justify-between items-center mb-1\">\n                                        <div class=\"text-xl font-bold font-red-hat-display\">Monthly</div>\n                                    </div>\n                                    <div class=\"font-red-hat-display inline-flex items-baseline mb-2\">\n                                        <span class=\"h4 text-gray-600 dark:text-gray-400\" data-ve-text=\"1\">$</span>\n                                        <span class=\"h3\" data-ve-text=\"1\">47</span>\n                                        <span class=\"font-medium text-gray-500 dark:text-gray-400\" data-ve-text=\"1\">/billed yearly</span>\n                                    </div>\n                     