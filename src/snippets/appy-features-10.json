              <span data-ve-text=\"1\">Unlimited web pages</span>\n                                    </li>\n                                    <li class=\"flex items-center mb-2\" data-ve-text=\"1\">\n                                        <svg class=\"w-3 h-3 fill-current text-teal-500 mr-3 shrink-0\" viewBox=\"0 0 12 12\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M10.28 2.28L3.989 8.575 1.695 6.28A1 1 0 00.28 7.695l3 3a1 1 0 001.414 0l7-7A1 1 0 0010.28 2.28z\" />\n                                        </svg>\n                                        <span data-ve-text=\"1\">Conversion analytics</span>\n                                    </li>\n                                    <li class=\"flex items-center mb-2\" data-ve-text=\"1\">\n                                        <svg class=\"w-3 h-3 fill-current text-teal-500 mr-3 shrink-0\" viewBox=\"0 0 12 12\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M10.28 2.28L3.989 8.575 1.695 6.28A1 1 0 00.28 7.695l3 3a1 1 0 001.414 0l7-7A1 1 0 0010.28 2.28z\" />\n                                        </svg>\n                                        <span data-ve-text=\"1\">A/B testing</span>\n                                    </li>\n                                    <li class=\"flex items-center mb-2\" data-ve-text=\"1\">\n                                        <svg class=\"w-3 h-3 fill-current text-teal-500 mr-3 shrink-0\" viewBox=\"0 0 12 12\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M10.28 2.28L3.989 8.575 1.695 6.28A1 1 0 00.28 7.695l3 3a1 1 0 001.414 0l7-7A1 1 0 0010.28 2.28z\" />\n                                        </svg>\n                                        <span data-ve-text=\"1\">Exclusive channels</span>\n                                    </li>\n                                    <li class=\"flex items-center mb-2\" data-ve-text=\"1\">\n                                        <svg class=\"w-3 h-3 fill-current text-teal-500 mr-3 shrink-0\" viewBox=\"0 0 12 12\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M10.28 2.28L3.989 8.575 1.695 6.28A1 1 0 00.28 7.695l3 3a1 1 0 001.414 0l7-7A1 1 0 0010.28 2.28z\" />\n                                        </svg>\n                                        <span data-ve-text=\"1\">Free resources</span>\n                                    </li>\n                                    <li class=\"flex items-center mb-2\" data-ve-text=\"1\">\n                                        <svg class=\"w-3 h-3 fill-current text-teal-500 mr-3 shrink-0\" viewBox=\"0 0 12 12\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M10.28 2.28L3.989 8.575 1.695 6.28A1 1 0 00.28 7.695l3 3a1 1 0 001.414 0l7-7A1 1 0 0010.28 2.28z\" />\n                                        </svg>\n                                        <span data-ve-text=\"1\">Landing page builder</span>\n                                    </li>\n                                    <li class=\"flex items-center mb-2\" data-ve-text=\"1\">\n                                        <svg class=\"w-3 h-3 fill-current text-teal-500 mr-3 shrink-0\" viewBox=\"0 0 12 12\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M10.28 2.28L3.989 8.575 1.695 6.28A1 1 0 00.28 7.695l3 3a1 1 0 001.414 0l7-7A1 1 0 0010.28 2.28z\" />\n                                        </svg>\n                                        <span data-ve-text=\"1\">Smart forms and reports</span>\n                                    </li>\n                                </ul>\n                            </div>\n\n                        </div>\n\n                    </div>\n                </div>\n            </section>"
