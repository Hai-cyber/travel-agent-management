  "html": "<section class=\"py-8\">\n  <div class=\"max-w-6xl mx-auto px-4 sm:px-6\"><img src=\"https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?w=1600&q=80&fit=crop\" alt=\"Travel visual\" class=\"w-full h-72 object-cover rounded-3xl mb-8\" data-ve-img=\"1\"></div>\n                            <h2 class=\"text-lg font-semibold mb-5\" data-ve-text=\"1\">Project Terms</h2>\n                            \n                            <div class=\"space-y-3\">\n                                \n                                <div class=\"text-sm odd:bg-linear-to-tr from-slate-100 to-slate-50 dark:from-slate-800/80 dark:to-slate-900 rounded-lg\">\n                                    <h3 data-ve-text=\"1\">\n                                        <button \n                                            id=\"terms-title-01\"\n                                            type=\"button\"\n                                            class=\"flex items-center justify-between w-full text-left font-medium px-5 py-3\"\n                                           \n                                           \n                                           \n                                         data-ve-text=\"1\" data-ve-btn=\"1\">\n                                            <span data-ve-text=\"1\">Payment schedule and options</span>\n                                            <svg class=\"fill-slate-400 dark:fill-slate-500 shrink-0 ml-8\" width=\"12\" height=\"12\" xmlns=\"http://www.w3.org/2000/svg\">\n                                                <rect y=\"5\" width=\"12\" height=\"2\" rx=\"1\" class=\"transform origin-center transition duration-200 ease-out\" />\n                                                <rect y=\"5\" width=\"12\" height=\"2\" rx=\"1\" class=\"transform origin-center rotate-90 transition duration-200 ease-out\" />\n                                            </svg>\n                                        </button>\n                          