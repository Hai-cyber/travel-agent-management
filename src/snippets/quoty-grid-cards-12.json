merica.\n                            </div>\n                        </section>\n                        <section class=\"py-8\">\n                            <h2 class=\"text-lg font-semibold mb-5\" data-ve-text=\"1\">Details</h2>\n                            <ul class=\"grid gap-4 min-[480px]:grid-cols-3 text-sm\">\n                                <li class=\"px-5 py-4 rounded-lg bg-linear-to-tr from-slate-950 to-slate-800 dark:from-slate-800/80 dark:to-slate-900\" data-ve-text=\"1\">\n                                    <div class=\"text-slate-200 font-medium\">Project Length</div>\n  </div>\n</section>"
