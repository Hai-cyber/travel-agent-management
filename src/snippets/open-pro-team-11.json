  "html": "<section class=\"py-12 md:py-20\">\n  <div class=\"max-w-6xl mx-auto px-4 sm:px-6\">\n<div\n                                        class=\"relative flex h-full flex-col rounded-2xl bg-linear-to-br from-gray-900/50 via-gray-800/25 to-gray-900/50 p-5 backdrop-blur-xs before:pointer-events-none before:absolute before:inset-0 before:rounded-[inherit] before:border before:border-transparent before:[background:linear-gradient(to_right,var(--color-gray-800),var(--color-gray-700),var(--color-gray-800))_border-box] before:[mask-composite:exclude_!important] before:[mask:linear-gradient(white_0_0)_padding-box,_linear-gradient(white_0_0)]\"\n                                    >\n                                        <div\n                                            class=\"relative mb-4 border-b pb-5 [border-image:linear-gradient(to_right,transparent,--theme(--color-slate-400/.25),transparent)1]\"\n                                        >\n                                            <div class=\"mb-2 font-nacelle text-[1rem] text-gray-200\">\n                                                Enterprise Team\n                                            </div>\n                                            <div class=\"mb-1.5 flex items-baseline font-nacelle\">\n                                                <span class=\"text-2xl text-indigo-200/65\" data-ve-text=\"1\">$</span>\n                                                <span\n                                                   \n                                                    class=\"text-4xl font-semibold tabular-nums text-gray-200\"\n                                                     data-ve-text=\"1\">87</span\n                                                >\n                                            </div>\n                                            <div class=\"mb-4 grow text-xs text-indigo-200/65\">\n                                                Per user/month, billed annually.\n                                            </div>\n                                            <a\n                                                class=\"btn-sm relative w-full bg-linear-to-b from-gray-800 to-gray-800/60 bg-[length:100%_100%] bg-[bottom] text-gray-300 before:pointer-events-none before:absolute before:inset-0 before:rounded-[inherit] before:border before:border-transparent before:[background:linear-gradient(to_right,var(--color-gray-800),var(--color-gray-700),var(--color-gray-800))_border-box] before:[mask-composite:exclude_!important] before:[mask:linear-gradient(white_0_0)_padding-box,_linear-gradient(white_0_0)] hover:bg-[length:100%_150%]\"\n                                                href=\"#\"\n                                                 data-ve-text=\"1\" data-ve-btn=\"1\">Start free trial</a\n                                            >\n                                        </div>\n                                        <p class=\"mb-4 text-sm italic text-gray-200\" data-ve-text=\"1\">Everything in Business, plus:</p>\n                                        <ul class=\"grow space-y-2 text-sm text-indigo-200/65\">\n                                            <li class=\"flex items-center\" data-ve-text=\"1\">\n                                                <svg\n                                                    class=\"mr-2 h-3 w-3 shrink-0 fill-current text-indigo-500\"\n                                                    viewBox=\"0 0 12 12\"\n                                                    xmlns=\"http://www.w3.org/2000/svg\"\n                                                >\n                                                    <path\n                                                        d=\"M10.28 2.28L3.989 8.575 1.695 6.28A1 1 0 00.28 7.695l3 3a1 1 0 001.414 0l7-7A1 1 0 0010.28 2.28z\"\n                                                    />\n                                                </svg>\n                                                <span data-ve-text=\"1\">Strongest connection</span>\n                                            </li>\n                                            <li class=\"flex items-center\" data-ve-text=\"1\">\n                                                <svg\n                                                    class=\"mr-2 h-3 w-3 shrink-0 fill-current text-indigo-500\"\n                                                    viewBox=\"0 0 12 12\"\n                                                    xmlns=\"http://www.w3.org/2000/svg\"\n                                                >\n                                                    <path\n                                                        d=\"M10.28 2.28L3.989 8.575 1.695 6.28A1 1 0 00.28 7.695l3 3a1 1 0 001.414 0l7-7A1 1 0 0010.28 2.28z\"\n                                                    />\n                                                </svg>\n                                                <span data-ve-text=\"1\">First calendar interaction</span>\n                                            </li>\n                                            <li class=\"flex items-center\" data-ve-text=\"1\">\n                                                <svg\n                                                    class=\"mr-2 h-3 w-3 shrink-0 fill-current text-indigo-500\"\n                                                    viewBox=\"0 0 12 12\"\n                                                    xmlns=\"http://www.w3.org/2000/svg\"\n                                                >\n                                                    <path\n                                                        d=\"M10.28 2.28L3.989 8.575 1.695 6.28A1 1 0 00.28 7.695l3 3a1 1 0 001.414 0l7-7A1 1 0 0010.28 2.28z\"\n                                                    />\n                                                </svg>\n                                                <span data-ve-text=\"1\">Historical attributes</span>\n                                            </li>\n                                            <li class=\"flex items-center\" data-ve-text=\"1\">\n                                                <svg\n                                                    class=\"mr-2 h-3 w-3 shrink-0 fill-current text-indigo-500\"\n                                                    viewBox=\"0 0 12 12\"\n                                                    xmlns=\"http://www.w3.org/2000/svg\"\n                                                >\n                                                    <path\n                                                        d=\"M10.28 2.28L3.989 8.575 1.695 6.28A1 1 0 00.28 7.695l3 3a1 1 0 001.414 0l7-7A1 1 0 0010.28 2.28z\"\n                                                    />\n                                                </svg>\n                                                <span data-ve-text=\"1\">Time comparisons</span>\n                                            </li>\n                                        </ul>\n                                    </div>\n                                </div>\n                            </div>\n\n                            \n                            <div class=\"mx-auto max-w-3xl\">\n                                <div class=\"pt-12 md:pt-20\">\n                                    <div class=\"text-center\">\n                                        <img\n                                            class=\"mb-3 inline-flex rounded-full\"\n                                            src=\"/api/tenant/template-assets/open-pro-html/images/large-testimonial-01.jpg\"\n                                            width=\"40\"\n                                            height=\"40\"\n                                            alt=\"Large testimonial\" data-ve-img=\"1\"\n                                        />\n                                        <p\n                                            class=\"animate-[gradient_6s_linear_infinite] bg-[linear-gradient(to_right,var(--color-gray-200),var(--color-indigo-200),var(--color-gray-50),var(--color-indigo-300),var(--color-gray-200))] bg-[length:200%_auto] bg-clip-text pb-3 font-nacelle text-xl font-semibold text-transparent\"\n                                         data-ve-text=\"1\">\n                                            “Open PRO lives up to its name. It's incredibly easy to use yet powerful\n                                            enough to handle all my content needs effortlessly. It's become an essential\n                                            part of our work routine.”\n                                        </p>\n                                        <div class=\"text-sm font-medium text-gray-200\">\n                                            <span data-ve-text=\"1\">Chris Pick</span>\n                                            <span class=\"text-gray-700\" data-ve-text=\"1\"> - </span>\n                                            <a\n                                                class=\"text-indigo-200/65 transition-colors hover:text-indigo-500\"\n                                                href=\"#\"\n                                                 data-ve-text=\"1\" data-ve-btn=\"1\">VP of Product, Disney</a\n                                            >\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n  </div>\n</section>"
}
