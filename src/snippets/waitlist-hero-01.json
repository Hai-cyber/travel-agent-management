px)] dark:after:[background-image:radial-gradient(circle_at_center,var(--color-gray-600)_1.5px,transparent_1.5px),radial-gradient(circle_at_center,var(--color-gray-600)_1.5px,transparent_1.5px)]\" aria-hidden=\"true\"></div>\n\n                                    <div class=\"space-y-3\">\n                                        <div>\n                                            <label class=\"sr-only\" for=\"email\" data-ve-text=\"1\">Email</label>\n                                            <div class=\"relative\">\n                                                <div class=\"absolute inset-y-0 left-0 text-gray-500/70 dark:text-gray-400/70 pl-4 flex items-center pointer-events-none\">\n                                                    <svg class=\"fill-current\" xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"14\">\n                                                        <path d=\"M14 0H2a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2Zm0 12H2V5.723l5.504 3.145a.998.998 0 0 0 .992 0L14 5.723V12Zm0-8.58L8 6.849 2 3.42V2h12v1.42Z\" />\n                                                    </svg>                                                      \n                                                </div>\n                                                <input id=\"email\" class=\"form-input text-sm w-full pl-10 pr-4\" type=\"email\" placeholder=\"Your email...\" required data-ve-input=\"1\" />\n                                            </div>\n                                        </div>\n                                        <div>\n                                            <button class=\"btn text-gray-100 bg-gray-900 hover:bg-gray-800 dark:text-gray-800 dark:bg-gray-100 dark:hover:bg-white w-full\" data-ve-text=\"1\" data-ve-btn=\"1\">Join The Waitlist</button>\n                                        </div>\n                                    </div>\n                                </form>\n                            </div>\n 