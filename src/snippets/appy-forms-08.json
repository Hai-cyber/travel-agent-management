  "html": "<section style=\"padding-top: 96px\" data-ve-hero-padded=\"1\">\n                <div class=\"max-w-6xl mx-auto px-4 sm:px-6\">\n                    <div class=\"pt-32 pb-10 md:pt-40 md:pb-16\">\n\n                        \n                        <div class=\"md:grid md:grid-cols-12 md:gap-12 lg:gap-20 items-center\">\n                            \n                            \n                            <div class=\"md:col-span-7 lg:col-span-7 mb-8 md:mb-0 text-center md:text-left\">\n                                <h1 class=\"h1 lg:text-6xl mb-4 font-red-hat-display font-black\" data-ve-text=\"1\">Your website, reimagined</h1>\n                                <p class=\"text-xl text-gray-600 dark:text-gray-400\" data-ve-text=\"1\">Our landing page template works on all devices, so you only have to set it up once, and get beautiful results forever.</p>\n                                \n                                <form class=\"mt-8\">\n                                    <div class=\"flex flex-col sm:flex-row justify-center max-w-sm mx-auto sm:max-w-md md:mx-0\">\n                                        <input type=\"tel\" class=\"form-input w-full mb-2 sm:mb-0 sm:mr-2\" placeholder=\"Phone number\" aria-label=\"Phone number\" data-ve-input=\"1\" />\n                                        <a class=\"btn text-white bg-teal-500 hover:bg-teal-400 shrink-0\" href=\"#\" data-ve-text=\"1\" data-ve-btn=\"1\">Request code</a>\n                                    </div>\n                                    \n                                    \n                                </form>\n                                <ul class=\"max-w-sm sm:max-w-md mx-auto md:max-w-none text-gray-600 dark:text-gray-400 mt-8 -mb-2\">\n                                    <li class=\"flex items-center mb-2\" data-ve-text=\"1\">\n                                        <svg class=\"w-3 h-3 fill-current text-teal-400 mr-2 shrink-0\" viewBox=\"0 0 12 12\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M10.28 2.28L3.989 8.575 1.695 6.28A1 1 0 00.28 7.695l3 3a1 1 0 001.414 0l7-7A1 1 0 0010.28 2.28z\" />\n                                        </svg>\n                                        <span data-ve-text=\"1\">Lorem ipsum is placeholder text commonly.</span>\n                                    </li>\n                                    <li class=\"flex items-center mb-2\" data-ve-text=\"1\">\n                                        <svg class=\"w-3 h-3 fill-current text-teal-400 mr-2 shrink-0\" viewBox=\"0 0 12 12\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M10.28 2.28L3.989 8.575 1.695 6.28A1 1 0 00.28 7.695l3 3a1 1 0 001.414 0l7-7A1 1 0 0010.28 2.28z\" />\n                                        </svg>\n                                        <span data-ve-text=\"1\">Excepteur sint occaecat cupidatat.</span>\n                                    </li>\n                                    <li class=\"flex items-center mb-2\" data-ve-text=\"1\">\n                                        <svg class=\"w-3 h-3 fill-current text-teal-400 mr-2 shrink-0\" viewBox=\"0 0 12 12\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M10.28 2.28L3.989 8.575 1.695 6.28A1 1 0 00.28 7.695l3 3a1 1 0 001.414 0l7-7A1 1 0 0010.28 2.28z\" />\n                                        </svg>\n                                        <span data-ve-text=\"1\">Lorem ipsum is placeholder text commonly.</span>\n                                    </li>\n                                </ul>\n                            </div>\n\n                            \n                            <div class=\"md:col-span-5 lg:col-span-5 text-center md:text-right\">\n                                <div class=\"inline-flex relative justify-center items-center\">\n                                    \n                                    <svg class=\"absolute mr-12 mt-32 pointer-events-none -z-1 dark:opacity-40\" aria-hidden=\"true\" width=\"678\" height=\"634\" viewBox=\"0 0 678 634\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                                        <circle cx=\"240\" cy=\"394\" r=\"240\" fill=\"url(#piphoneill_paint0_radial)\" fill-opacity=\".4\" />\n                                        <circle cx=\"438\" cy=\"240\" r=\"240\" fill=\"url(#piphoneill_paint1_radial)\" fill-opacity=\".6\" />\n                                        <defs>\n                                            <radialGradient id=\"piphoneill_paint0_radial\" cx=\"0\" cy=\"0\" r=\"1\" gradientUnits=\"userSpaceOnUse\" gradientTransform=\"rotate(90 -77 317) scale(189.054)\">\n                                                <stop stop-color=\"#667EEA\" />\n                                                <stop offset=\"1\" stop-color=\"#667EEA\" stop-opacity=\".01\" />\n                                            </radialGradient>\n                                            <radialGradient id=\"piphoneill_paint1_radial\" cx=\"0\" cy=\"0\" r=\"1\" gradientUnits=\"userSpaceOnUse\" gradientTransform=\"rotate(90 99 339) scale(189.054)\">\n                                                <stop stop-color=\"#9F7AEA\" />\n                                                <stop offset=\"1\" stop-color=\"#9F7AEA\" stop-opacity=\".01\" />\n                                            </radialGradient>\n                                        </defs>\n                                    </svg>\n                                    \n                                    <img class=\"absolute\" src=\"/api/tenant/template-assets/appy-html/images/mockup-image-01.jpg\" width=\"290\" height=\"624\" style=\"max-width: 84.33%;\" alt=\"Features illustration\" data-ve-img=\"1\" />\n                                    \n                                    <img class=\"relative max-w-full mx-auto md:mr-0 md:max-w-none h-auto pointer-events-none\" src=\"/api/tenant/template-assets/appy-html/images/iphone-mockup.png\" width=\"344\" height=\"674\" alt=\"iPhone mockup\" aria-hidden=\"true\" data-ve-img=\"1\" />\n                                    \n                                    <a class=\"absolute hover:opacity-75 transition duration-150 ease-in-out\" href=\"#\" data-ve-text=\"1\" data-ve-btn=\"1\">\n                                        <img src=\"/api/tenant/template-assets/appy-html/images/play-button.svg\" width=\"96\" height=\"96\" alt=\"Play\" data-ve-img=\"1\" />\n                                    </a>\n                                </div>\n\n                                \n                                <div\n                                    class=\"fixed inset-0 z-50 bg-black/75 transition-opacity\"\n                                   \n                                   \n                                   \n                                   \n                                   \n                                   \n                                   \n                                    aria-hidden=\"true\"\n                                   \n                                ></div>\n\n                                \n                                <div\n                                    id=\"modal\"\n                                    class=\"fixed inset-0 z-50 overflow-hidden flex items-center justify-center transform px-4 sm:px-6\"\n                                   \n                                    aria-modal=\"true\"\n                                    aria-labelledby=\"modal-headline\"\n                                   \n                                   \n                                   \n                                   \n                                   \n                                   \n                                   \n                                   \n                                >\n                                    <div class=\"bg-white overflow-auto max-w-6xl w-full max-h-full\">\n                                        <div class=\"relative pb-9/16\">\n                                            <video class=\"absolute w-full h-full\" width=\"1920\" height=\"1080\" loop controls>\n                                                <source src=\"/api/tenant/template-assets/appy-html/videos/video.mp4\" type=\"video/mp4\" />\n                                                Your browser does not support the video tag.\n                                            </video>\n                                        </div>\n                                    </div>\n                                </div>                    \n                            </div>\n                            \n                        </div>\n\n                    </div>\n                </div>\n            </section>"
