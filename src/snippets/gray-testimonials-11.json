  "html": "<section class=\"bg-zinc-800\">\n                <div class=\"py-12 md:py-20\">\n                    <div class=\"max-w-6xl mx-auto px-4 sm:px-6\">\n                        <div class=\"max-w-3xl mx-auto text-center pb-12 md:pb-20\">\n                            <h2 class=\"font-inter-tight text-3xl md:text-4xl font-bold text-zinc-200\" data-ve-text=\"1\">Loved by thousands of creatives from around the world</h2>\n                        </div>\n                    </div>\n                    <div class=\"max-w-[94rem] mx-auto space-y-6\">\n                        \n                        <div\n                           \n                           \n                            class=\"w-full inline-flex flex-nowrap overflow-hidden [mask-image:_linear-gradient(to_right,transparent_0,_black_28%,_black_calc(100%-28%),transparent_100%)] group\"\n                        >\n                            <div class=\"flex items-start justify-center md:justify-start [&>div]:mx-3 animate-infinite-scroll group-hover:[animation-play-state:paused]\">\n                                \n                                <div class=\"rounded-sm h-full w-[22rem] border border-transparent [background:linear-gradient(#323237,#323237)_padding-box,linear-gradient(120deg,var(--color-zinc-700),--theme(--color-zinc-700/0),var(--color-zinc-700))_border-box] p-5\">\n                                    <div class=\"flex items-center mb-4\">\n                                        <img class=\"shrink-0 rounded-full mr-3\" src=\"/api/tenant/template-assets/gray-html/images/testimonial-01.jpg\" width=\"44\" height=\"44\" alt=\"Testimonial 01\" data-ve-img=\"1\" />\n                                        <div>\n                                            <div class=\"font-inter-tight font-bold text-zinc-200\">Lina James</div>\n                                            <div>\n                                                <a class=\"text-sm font-medium text-zinc-500 hover:text-zinc-300 transition\" href=\"#\" data-ve-text=\"1\" data-ve-btn=\"1\">@linaj87</a>\n                                            </div>\n                                        </div>\n                                    </div>\n                                    <div class=\"text-zinc-500 before:content-['\\0022'] after:content-['\\0022']\">\n                                        Extremely thoughtful approaches to business. I highly recommend this product to anyone wanting to jump into something new.\n                                    </div>\n                                </div>\n                                \n                                <div class=\"rounded-sm h-full w-[22rem] border border-transparent [background:linear-gradient(#323237,#323237)_padding-box,linear-gradient(120deg,var(--color-zinc-700),--theme(--color-zinc-700/0),var(--color-zinc-700))_border-box] p-5\">\n                                    <div class=\"flex items-center mb-4\">\n                                        <img class=\"shrink-0 rounded-full mr-3\" src=\"/api/tenant/template-assets/gray-html/images/testimonial-02.jpg\" width=\"44\" height=\"44\" alt=\"Testimonial 02\" data-ve-img=\"1\" />\n                                        <div>\n                                            <div class=\"font-inter-tight font-bold text-zinc-200\">Sarah Mendes</div>\n                                            <div>\n                                                <a class=\"text-sm font-medium text-zinc-500 hover:text-zinc-300 transition\" href=\"#\" data-ve-text=\"1\" data-ve-btn=\"1\">@saramendes</a>\n                                            </div>\n                                        </div>\n                                    </div>\n                                    <div class=\"text-zinc-500 before:content-['\\0022'] after:content-['\\0022']\">\n                                        Extremely thoughtful approaches to business. I highly recommend this product to anyone wanting to jump into something new.\n                                    </div>\n                                </div>\n                                \n                                <div class=\"rounded-sm h-full w-[22rem] border border-transparent [background:linear-gradient(#323237,#323237)_padding-box,linear-gradient(120deg,var(--color-zinc-700),--theme(--color-zinc-700/0),var(--color-zinc-700))_border-box] p-5\">\n                                    <div class=\"flex items-center mb-4\">\n                                        <img class=\"shrink-0 rounded-full mr-3\" src=\"/api/tenant/template-assets/gray-html/images/testimonial-03.jpg\" width=\"44\" height=\"44\" alt=\"Testimonial 03\" data-ve-img=\"1\" />\n                                        <div>\n                                            <div class=\"font-inter-tight font-bold text-zinc-200\">Michał Rutt</div>\n                                            <div>\n                                                <a class=\"text-sm font-medium text-zinc-500 hover:text-zinc-300 transition\" href=\"#\" data-ve-text=\"1\" data-ve-btn=\"1\">@michrutt</a>\n                                            </div>\n                                        </div>\n                                    </div>\n                                    <div class=\"text-zinc-500 before:content-['\\0022'] after:content-['\\0022']\">\n                                        Extremely thoughtful approaches to business. I highly recommend this product to anyone wanting to jump into something new.\n                                    </div>\n                                </div>\n                                \n                                <div class=\"rounded-sm h-full w-[22rem] border border-transparent [background:linear-gradient(#323237,#323237)_padding-box,linear-gradient(120deg,var(--color-zinc-700),--theme(--color-zinc-700/0),var(--color-zinc-700))_border-box] p-5\">\n                                    <div class=\"flex