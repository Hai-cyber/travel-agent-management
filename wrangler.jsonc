{
	"name": "square-wind-2594",
	"main": "src/index.js",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"workers_dev": true,
	"routes": [
		{
			"pattern": "*.tours-market.com/*",
			"zone_name": "tours-market.com"
		},
		{
			"pattern": "tours-market.com",
			"custom_domain": true
		}
	],
	"preview_urls": true,
	"compatibility_date": "2026-03-10",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"ai": {
		"binding": "AI"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1
		}
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "travel_agent_db",
			"database_id": "d4f609a9-0e4a-44bd-ac3b-74865bcfd6ba",
			"migrations_dir": "db/migrations"
		}
	],
	"kv_namespaces": [
		{
			"id": "f73f49731e054d35985ee4d1326f6258",
			"binding": "TOUR_PRESETS"
		}
	],
	"r2_buckets": [
		{
			"binding": "TOUR_PAGES",
			"bucket_name": "tour-pages"
		},
		{
			"binding": "BOOKING_PROOFS",
			"bucket_name": "booking-proofs"
		},
		{
			"binding": "SITE_TEMPLATES",
			"bucket_name": "site-templates"
		}
	],
	"triggers": {
		"crons": [
			"*/15 * * * *",
			"0 8 * * *"
		]
	},
	// Stripe billing vars — override with real values in .dev.vars (local) or
	// wrangler secret put STRIPE_SECRET_KEY (production).
	// NEVER commit real keys here — these are placeholder strings only.
	//
	// CF Registrar vars — required for domain purchase (CHK-R67).
	//   CF_ACCOUNT_ID          — Cloudflare account ID (from CF dashboard)
	//   CF_REGISTRAR_API_TOKEN — CF API token with Registrar:Edit scope
	//   STRIPE_DOMAIN_WEBHOOK_SECRET — Stripe webhook secret for /api/domains/stripe-webhook
	"vars": {
		"STRIPE_PRICE_ID": "price_REPLACE_ME",
		"STRIPE_PRICE_ID_EXTRA_PROPERTY": "price_REPLACE_ME_EXTRA_PROPERTY",
		"STRIPE_PRICE_ID_EXTRA_STAFF": "price_REPLACE_ME_EXTRA_STAFF",
		"PLATFORM_BASE_URL": "https://tours-market.com",
		"GOOGLE_CLIENT_ID": "373960611484-3umaivbmg6vcnfan49nvcs75dsb705ir.apps.googleusercontent.com",
		"TURNSTILE_SITE_KEY": "0x4AAAAAAC0RoU63f5ipBatl",
		"CF_ACCOUNT_ID": "REPLACE_ME",
		"CF_REGISTRAR_API_TOKEN": "REPLACE_ME"
	},
	"env": {
		"staging": {
			"name": "square-wind-2594-staging",
			"preview_urls": true,
			"workers_dev": true,
			"ai": {
				"binding": "AI"
			},
			"routes": [
				{
					"pattern": "staging.tours-market.com",
					"custom_domain": true
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "travel_agent_db",
					"database_id": "d4f609a9-0e4a-44bd-ac3b-74865bcfd6ba",
					"migrations_dir": "db/migrations"
				}
			],
			"kv_namespaces": [
				{
					"id": "f73f49731e054d35985ee4d1326f6258",
					"binding": "TOUR_PRESETS"
				}
			],
			"r2_buckets": [
				{
					"binding": "TOUR_PAGES",
					"bucket_name": "tour-pages"
				},
				{
					"binding": "BOOKING_PROOFS",
					"bucket_name": "booking-proofs"
				},
				{
					"binding": "SITE_TEMPLATES",
					"bucket_name": "site-templates"
				}
			],
			"vars": {
				"STRIPE_PRICE_ID": "price_REPLACE_ME",
				"STRIPE_PRICE_ID_EXTRA_PROPERTY": "price_REPLACE_ME_EXTRA_PROPERTY",
				"STRIPE_PRICE_ID_EXTRA_STAFF": "price_REPLACE_ME_EXTRA_STAFF",
				"PLATFORM_BASE_URL": "https://staging.tours-market.com",
				"GOOGLE_CLIENT_ID": "373960611484-3umaivbmg6vcnfan49nvcs75dsb705ir.apps.googleusercontent.com"
			}
		}
	}
}