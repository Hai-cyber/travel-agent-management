{
	"name": "travel-agent-management-new",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"backfill:tenant-seed": "node ./scripts/backfill-tenant-seed.mjs",
		"backfill:tenant-seed:apply": "npx wrangler d1 execute travel_agent_db --remote --config ./wrangler.jsonc --file ./scripts/backfill-tenant-seed.sql",
		"clean:wrangler": "node ./scripts/clean-wrangler-cache.mjs",
		"db:migrate:local": "node ./scripts/apply-local-migrations.mjs",
		"dev:clean": "node ./scripts/clean-wrangler-cache.mjs && wrangler dev --config ./wrangler.jsonc",
		"deploy": "wrangler deploy --config ./wrangler.jsonc",
		"dev": "wrangler dev --config ./wrangler.jsonc",
		"start": "wrangler dev --config ./wrangler.jsonc",
		"test": "node ./scripts/smoke-local.mjs",
		"test:local": "node ./scripts/smoke-local.mjs"
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "^3.1019.0",
		"wrangler": "^4.76.0"
	},
	"dependencies": {
		"fflate": "^0.8.2",
		"hono": "^4.12.9",
		"nanoid": "^5.1.7"
	}
}
